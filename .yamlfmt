# One config, copied verbatim into every repo: CI checks out one repo at a time.
# Required: without it the ** patterns below are silently unenforced.
doublestar: true
exclude:
  - "**/node_modules/**"
  - "**/pnpm-lock.yaml"
  # kustomize edit rewrites these two on every deploy in its own list style.
  - "**/overlays/server/dev/kustomization.yaml"
  - "**/overlays/server/prod/kustomization.yaml"

formatter:
  type: basic
  indentless_arrays: false
  retain_line_breaks: true
  scan_folded_as_literal: true
  # include_document_start stays unset: files keep the --- markers they have.
